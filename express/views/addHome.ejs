<%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md">
      <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">Register Your Home on AirBnB</h1>
      <% if (errors.length > 0) { %>
        <div class="max-w-md mx-auto mb-4 rounded-md border border-red-300 bg-red-50 p-4 text-red-700" role="alert">
          <p class="font-semibold">Please correct the following:</p>
          <ul class="mt-2 list-disc pl-5">
            <% errors.forEach(error => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      <form action="/host/add-home" method="POST" class="max-w-md mx-auto">
        <input
          type="text"
          name="houseName"
          placeholder="Enter your House Name"
          value="<%= values.houseName %>"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <input
          type="number"
          name="price"
          placeholder="Price Per Night"
          value="<%= values.price %>"
          min="0.01"
          step="0.01"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <input
          type="text"
          name="location"
          placeholder="Location"
          value="<%= values.location %>"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <input
          type="number"
          name="rating"
          placeholder="Rating"
          value="<%= values.rating %>"
          min="0"
          max="5"
          step="0.1"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <input
          type="url"
          name="photoUrl"
          placeholder="Enter Photo URL"
          value="<%= values.photoUrl %>"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <input type="submit" value="Submit" class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300" />
      </form>
    </main>
  </body>
</html>
